generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  USER
  ADMIN
}

// Admin actions on inventory (separate from snack withdrawals).
enum StockAction {
  CREATE
  UPDATE
  ADJUST
  DELETE
}

model User {
  id          String          @id @db.Uuid // = Supabase auth user id
  email       String          @unique
  name        String? // display name captured at registration
  phone       String? // phone number captured at registration
  role        Role            @default(USER)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  withdrawals WithdrawalLog[]
  stockLogs   StockLog[]

  @@map("users")
}

model Snack {
  id                Int             @id @default(autoincrement())
  name              String
  description       String?
  category          String          @default("อื่นๆ")
  quantity          Int             @default(0)
  lowStockThreshold Int             @default(5) @map("low_stock_threshold")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  withdrawals       WithdrawalLog[]
  stockLogs         StockLog[]

  @@map("snacks")
}

// Audit trail of admin inventory changes: create/edit/adjust/delete a snack.
model StockLog {
  id        Int         @id @default(autoincrement())
  snackId   Int?        @map("snack_id")
  snack     Snack?      @relation(fields: [snackId], references: [id], onDelete: SetNull)
  snackName String      @map("snack_name") // snapshot so it survives snack deletion
  userId    String?     @map("user_id") @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    StockAction
  before    Int? // quantity before the change (null for CREATE)
  after     Int? // quantity after the change (null for DELETE)
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("stock_logs")
}

model WithdrawalLog {
  id          Int      @id @default(autoincrement())
  snackId     Int?     @map("snack_id")
  snack       Snack?   @relation(fields: [snackId], references: [id], onDelete: SetNull)
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  withdrawnBy String   @map("withdrawn_by")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("withdrawal_logs")
}